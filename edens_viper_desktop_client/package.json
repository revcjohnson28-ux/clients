{
  "name": "edens-viper-chat-desktop",
  "version": "1.0.0",
  "description": "Desktop client for Eden's Viper Chat Network",
  "main": "main.js",
  "author": "Eden's Viper",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.edensviper.chat",
    "productName": "Eden's Viper Chat",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eden's Viper Chat"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.social-networking"
    }
  }
}
